function whoForm(cont){
  var w=S.who||{};
  return '<form class="who" id="who-form" novalidate>'+
   '<h3>Tell us who you are</h3>'+
   '<p class="muted">We’ll use this to send you your results and help you find a team.</p>'+
   '<div class="field"><label for="who-name">Full name</label><input id="who-name" name="name" type="text" autocomplete="name" required maxlength="100" value="'+esc(w.name||"")+'"></div>'+
   '<div class="field"><label for="who-email">Email</label><input id="who-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" value="'+esc(w.email||"")+'"></div>'+
   '<div class="field"><label for="who-phone">Phone</label><input id="who-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="30" value="'+esc(w.phone||"")+'"></div>'+
   '<div class="hp" aria-hidden="true"><label for="who-website">Website</label><input id="who-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>'+
   '<p class="form-error" id="who-error" role="alert"></p>'+
   '<p class="privacy">Your contact info and results are shared with City Church staff so they can help you take a next step. They are never shared outside the church.</p>'+
   '<div class="row"><button class="btn" type="submit">'+(cont?"Continue where I left off":"Begin the test")+'</button></div>'+
  '</form>';
}

function progress(){
  var pct=Math.round(S.i/TOTAL*100), part="Tap how much it sounds like you";
  return '<div class="prog"><div class="prog-meta"><span class="part">'+part+'</span><span>'+(S.i+1)+' of '+TOTAL+'</span></div>'+
   '<div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="'+TOTAL+'" aria-valuenow="'+S.i+'"><span style="width:'+pct+'%"></span></div></div>';
}

function viewGift(){
  var it=ITEMS[S.i], key=ikey(it), cur=S.g[key]||0;
  var h=progress()+'<div class="q"><h2 tabindex="-1" id="focus">'+esc(it.text)+'</h2><div class="opts" role="group" aria-label="How much is this like you?">';
  for(var v=1;v<=5;v++)h+='<button class="opt" data-act="rate" data-v="'+v+'" aria-pressed="'+(cur===v)+'">'+dots(v)+'<span>'+LIKERT[v-1]+'</span></button>';
  h+='</div><div class="nav">'+(S.i>0?'<button class="btn ghost" data-act="back">Back</button>':'<span></span>')+
     (cur?'<button class="btn ghost" data-act="next">Next</button>':'<span></span>')+'</div></div>';
  return h;
}

function compute(){
  var gifts=GIFTS.map(function(g,gi){var sum=0;for(var s=0;s<4;s++)sum+=(S.g[gi+"-"+s]||0);return {g:g,sum:sum,pct:Math.round((sum-4)/16*100)};});
  gifts.sort(function(a,b){return b.sum-a.sum||a.g.name.localeCompare(b.g.name);});
  var sums={D:0,I:0,S:0,C:0};
  ["D","I","S","C"].forEach(function(k){for(var q=0;q<DISC[k].length;q++)sums[k]+=(S.g["d"+k+"-"+q]||0);});
  var mean=(sums.D+sums.I+sums.S+sums.C)/4;
  var disc=["D","I","S","C"].map(function(k){var rel=sums[k]-mean;return {k:k,raw:rel,pct:Math.round(Math.max(0,Math.min(100,50+rel/10*50)))};});
  var ranked=disc.slice().sort(function(a,b){return b.raw-a.raw;});
  return {gifts:gifts,disc:disc,ranked:ranked};
}

function teamMatches(R){
  var gp={};R.gifts.forEach(function(x){gp[x.g.id]=x;});
  var dp={};R.disc.forEach(function(x){dp[x.k]=x.pct;});
  return TEAMS.map(function(t){
    var gl=(t.gifts||[]).map(function(id){return gp[id];}).filter(Boolean);
    var wts=[1,0.8,0.6,0.5,0.4],wsum=0,gAvg=0;gl.forEach(function(x,i){var w=wts[Math.min(i,4)];gAvg+=x.pct*w;wsum+=w;});gAvg=wsum?gAvg/wsum:0;
    var gMax=gl.length?Math.max.apply(null,gl.map(function(x){return x.pct;})):0;
    var gScore=gl.length?(0.6*gAvg+0.4*gMax):0;
    var ds=(t.disc||[]).map(function(k){return dp[k];}).filter(function(v){return v!=null;});
    var dScore=ds.length?ds.reduce(function(s,v){return s+v;},0)/ds.length:50;
    var best=gl.slice().sort(function(a,b){return b.sum-a.sum;}).slice(0,2).map(function(x){return x.g.name;});
    return {t:t,score:0.75*gScore+0.25*dScore,best:best};
  }).sort(function(a,b){return b.score-a.score;}).filter(function(m,i,all){
    // A role listed more than once (different gift paths) keeps only its best-scoring entry.
    for(var j=0;j<i;j++)if(all[j].t.team===m.t.team&&all[j].t.role===m.t.role)return false;
    return true;
  });
}

function pickRoles(R){
  var all=teamMatches(R),cnt={},M=[],used={};
  all.forEach(function(m){if(M.length<3&&(cnt[m.t.team]||0)<2){cnt[m.t.team]=(cnt[m.t.team]||0)+1;M.push(m);used[m.t.team+"|"+m.t.role]=1;}});
  return {all:all,M:M,used:used};
}

function discLabel(R){
  var p1=R.ranked[0], p2=R.ranked[1];
  return {code:p1.k+"/"+p2.k,label:DISC_INFO[p1.k].name+" and "+DISC_INFO[p2.k].name};
}

function rolesForGift(id){
  var out=[];
  TEAMS.forEach(function(t){var i=(t.gifts||[]).indexOf(id);if(i>=0)out.push({t:t,rank:i});});
  return out.sort(function(a,b){return a.rank-b.rank;}).map(function(x){return x.t;})
    .filter(function(t,i,all){for(var j=0;j<i;j++)if(all[j].team===t.team&&all[j].role===t.role)return false;return true;});
}

function giftMore(g){
  var roles=rolesForGift(g.id);
  return '<p>'+esc(g.about)+'</p><p class="signs-h">Signs you may have this gift</p><ul class="signs">'+
    g.signs.map(function(t){return '<li>'+esc(t)+'</li>';}).join('')+'</ul>'+
    '<p class="signs-h">Where this gift serves at City Church</p>'+
    (roles.length?'<ul class="serves">'+roles.map(function(t){
      var url=TEAM_PAGES[t.team];
      return '<li>'+(url?'<a href="'+url+'">'+esc(t.role)+'</a>':esc(t.role))+(t.team!==t.role?' <span class="muted">· '+esc(t.team)+'</span>':'')+'</li>';
    }).join('')+'</ul>':'<p class="muted">This gift can strengthen any team. Talk with a staff member about where it fits best for you.</p>');
}

function hasInterest(m){
  return (S.interests||[]).some(function(x){return x.role===m.t.role&&x.team===m.t.team;});
}

function interestBtn(m){
  var on=hasInterest(m);
  return '<button class="btn '+(on?'':'ghost ')+'interest" data-act="interest" data-role="'+esc(m.t.role)+'" data-team="'+esc(m.t.team)+'" aria-pressed="'+on+'"'+(S.sid?'':' disabled')+'>'+
    (on?'<span aria-hidden="true">✓</span> Interested':'I’m interested')+'</button>'+
    (on?'<p class="interest-note">We’ll let the '+esc(m.t.team)+' team know. Tap again to undo.</p>':'');
}

function summary(){
  var R=compute(), d=discLabel(R), P=pickRoles(R);
  function gift(x,full){var o={name:x.g.name,score:x.sum,pct:x.pct};if(full){o.def=x.g.def;o.ref=x.g.ref;o.about=x.g.about;o.signs=x.g.signs;}return o;}
  function style(k){var i=DISC_INFO[k];return {k:k,name:i.name,line:i.line,use:i.use,grow:i.grow};}
  return {
    topGifts:R.gifts.slice(0,5).map(function(x){return gift(x,true);}),
    allGifts:R.gifts.map(function(x){return gift(x,false);}),
    together:together(R),
    disc:{code:d.code,label:d.label,primary:style(R.ranked[0].k),secondary:style(R.ranked[1].k),
      bars:R.disc.map(function(x){return {k:x.k,name:DISC_INFO[x.k].name,pct:x.pct};})},
    roles:P.M.map(function(m){return {role:m.t.role,team:m.t.team,description:m.t.description,
      why:m.best.length?"Fits your gifts in "+m.best.join(" and ")+".":"",url:TEAM_PAGES[m.t.team]||""};})
  };
}

function viewResults(){
  var R=compute(), top=R.gifts.slice(0,3), next=R.gifts.slice(3,5);
  var p1=R.ranked[0], p2=R.ranked[1], dl=discLabel(R);
  var h='<div class="res">'+header()+
   '<h2 class="sg-title" tabindex="-1" id="focus">Your results</h2>'+
   '<p class="lede muted">Your strongest gifts are '+esc(top[0].g.name)+', '+esc(top[1].g.name)+', and '+esc(top[2].g.name)+'. Your personality style is mostly '+esc(DISC_INFO[p1.k].name)+', with some '+esc(DISC_INFO[p2.k].name)+'.</p>';

  h+='<div class="sec"><h2>Your top spiritual gifts</h2>';
  top.forEach(function(x){
    h+='<div class="card top"><div class="meta"><h3>'+esc(x.g.name)+'</h3><span class="score">'+x.sum+' of 20</span></div>'+
       '<div class="meter" aria-hidden="true"><span style="width:'+x.pct+'%"></span></div>'+
       '<p class="def">'+esc(x.g.def)+'</p>'+giftMore(x.g)+'<p class="ref">'+esc(x.g.ref)+'</p></div>';
  });
  next.forEach(function(x){
    h+='<div class="card"><div class="meta"><h3>'+esc(x.g.name)+'</h3><span class="score">'+x.sum+' of 20</span></div>'+
       '<div class="meter" aria-hidden="true"><span style="width:'+x.pct+'%"></span></div>'+
       '<p class="def">'+esc(x.g.def)+'</p><details class="more"><summary>Read more about '+esc(x.g.name)+'</summary>'+giftMore(x.g)+'</details><p class="ref">'+esc(x.g.ref)+'</p></div>';
  });
  h+='<details class="all"><summary>See all '+GIFTS.length+' gifts</summary><ul class="list">';
  R.gifts.forEach(function(x){h+='<li><details class="gift"><summary><b>'+esc(x.g.name)+'</b><div class="meter" aria-hidden="true"><span style="width:'+x.pct+'%"></span></div><em>'+x.sum+'</em></summary>'+
    '<div class="gift-body"><p class="def">'+esc(x.g.def)+'</p>'+giftMore(x.g)+'<p class="ref">'+esc(x.g.ref)+'</p></div></details></li>';});
  h+='</ul></details></div>';

  h+='<div class="sec"><h2>Your personality style</h2>'+
     '<div class="disc-head"><span class="big">'+dl.code+'</span><span class="muted">'+esc(dl.label)+'</span></div>'+
     '<div class="disc-bars">';
  R.disc.forEach(function(x){h+='<div class="r"><b>'+esc(DISC_INFO[x.k].name)+'</b><div class="meter" aria-hidden="true"><span style="width:'+x.pct+'%"></span></div><em>'+x.pct+'</em></div>';});
  h+='</div>'+
     '<div class="card"><h3>'+esc(DISC_INFO[p1.k].name)+'</h3><p>'+esc(DISC_INFO[p1.k].line)+'</p><p>'+esc(DISC_INFO[p1.k].use)+'</p><p class="muted" style="margin:0">To grow: '+esc(DISC_INFO[p1.k].grow)+'</p></div>'+
     '<div class="card"><h3>'+esc(DISC_INFO[p2.k].name)+' (your second style)</h3><p>'+esc(DISC_INFO[p2.k].line)+'</p><p>'+esc(DISC_INFO[p2.k].use)+'</p><p class="muted" style="margin:0">To grow: '+esc(DISC_INFO[p2.k].grow)+'</p></div>'+
     '</div>';

  h+='<div class="sec"><h2>How your gifts and style work together</h2>'+
     '<p class="muted">Your personality shapes how your gifts come out. Here’s how your top gifts tend to look as '+(/^[AEIOU]/.test(DISC_INFO[p1.k].name)?'an ':'a ')+esc(DISC_INFO[p1.k].name)+'. And because your second style is '+esc(DISC_INFO[p2.k].name)+', '+STYLE_ALSO[p2.k]+'.</p>';
  together(R).forEach(function(t){
    h+='<div class="card combo"><h3>'+esc(t.gift)+' <span class="plus">+</span> '+esc(t.style)+'</h3><p>'+esc(t.text)+'</p></div>';
  });
  h+='</div>';

  if(TEAMS.length){
    var P=pickRoles(R),all=P.all,M=P.M,used=P.used;
    h+='<div class="sec"><h2>Where you could serve</h2><p class="muted">These three fit your gifts and style best. They are suggestions, not assignments. Tap “I’m interested” on any of them, or on anything in the full list below.</p>';
    M.forEach(function(m){
      h+='<div class="card top team"><h3>'+esc(m.t.role||m.t.name)+'</h3>'+(m.t.team&&m.t.team!==m.t.role?'<p class="ref" style="margin:0 0 4px">'+esc(m.t.team)+'</p>':"")+(m.t.description?'<p>'+esc(m.t.description)+'</p>':"")+
         (m.best.length?'<p class="why">Fits your gifts in '+m.best.map(esc).join(" and ")+'.</p>':"")+
         (TEAM_ABOUT[m.t.team]?'<p class="team-about"><b>About the '+esc(m.t.team)+(/team$/i.test(m.t.team)?'':' team')+':</b> '+esc(TEAM_ABOUT[m.t.team])+'</p>':"")+
         (m.t.contact?'<p class="ref">'+esc(m.t.contact)+'</p>':"")+
         '<div class="team-actions"><div class="interest-wrap" data-key="'+esc(m.t.team+"|"+m.t.role)+'">'+interestBtn(m)+'</div>'+
         (TEAM_PAGES[m.t.team]?'<a class="team-link" href="'+TEAM_PAGES[m.t.team]+'">View team page <span aria-hidden="true">→</span></a>':"")+'</div></div>';
    });
    var order=[],groups={};
    all.forEach(function(m){if(used[m.t.team+"|"+m.t.role])return;if(!groups[m.t.team]){groups[m.t.team]=[];order.push(m.t.team);}groups[m.t.team].push(m);});
    h+='<h3 style="margin:30px 0 12px">The rest of our serving teams</h3>';
    order.forEach(function(team){
      h+='<div class="card"><h3>'+(TEAM_PAGES[team]?'<a class="team-head" href="'+TEAM_PAGES[team]+'">'+esc(team)+' <span aria-hidden="true">→</span></a>':esc(team))+'</h3>'+
        (TEAM_ABOUT[team]&&!(groups[team].length===1&&groups[team][0].t.role===team)?'<p class="team-blurb">'+esc(TEAM_ABOUT[team])+'</p>':'');
      groups[team].forEach(function(m){
        h+='<div class="rest-role">'+(m.t.role!==team?'<b>'+esc(m.t.role)+'</b> ':'')+
          (m.t.description?'<span class="muted">'+esc(m.t.description)+'</span>':'')+
          '<div class="interest-wrap" data-key="'+esc(m.t.team+"|"+m.t.role)+'">'+interestBtn(m)+'</div></div>';
      });
      h+='</div>';
    });
    h+='</div>';
  }

  h+='<p class="note">This is a tool for reflection, not a diagnosis, and it is not a formal or validated assessment. '+esc(CONFIG.followUp)+'</p>'+
     '<div class="noprint" id="sg-actions">'+actionsHtml()+'</div></div>';
  return h;
}

var saveState="idle", saveError="", emailState="idle", emailMsg="";

function actionsHtml(){
  var email=S.who&&S.who.email?S.who.email:"";
  var status="";
  if(saveState==="saving")status='<p class="status">Saving your results…</p>';
  else if(saveState==="error")status='<p class="status err">'+esc(saveError)+' <button class="linkbtn" data-act="resubmit">Try again</button></p>';
  if(emailState==="sent")status+='<p class="status ok">'+esc(emailMsg)+'</p>';
  else if(emailState==="error")status+='<p class="status err">'+esc(emailMsg)+'</p>';
  var canEmail=!!S.sid&&emailState!=="sending";
  return '<div aria-live="polite">'+status+'</div>'+
   '<div class="row" style="margin-top:16px">'+
    '<button class="btn" data-act="email"'+(canEmail?'':' disabled')+'>'+(emailState==="sending"?"Sending…":"Email my results")+'</button>'+
    '<button class="btn ghost" data-act="print">Download or print</button>'+
    '<button class="btn ghost" data-act="restart">'+(confirmReset?"Tap again to erase and retake":"Retake the test")+'</button>'+
   '</div>'+
   (email?'<p class="muted small">Email goes to '+esc(email)+'.</p>':'');
}

function refreshInterestButtons(){
  [].slice.call(document.querySelectorAll('.interest-wrap')).forEach(function(w){
    var key=w.getAttribute("data-key"), i=key.indexOf("|");
    w.innerHTML=interestBtn({t:{team:key.slice(0,i),role:key.slice(i+1)}});
  });
}

// Taps go to the server one at a time so the combined staff email always reflects the latest list.
var interestQueue=Promise.resolve();
function toggleInterest(b){
  if(!S.sid||b.disabled)return;
  var role=b.getAttribute("data-role"), team=b.getAttribute("data-team"), on=b.getAttribute("aria-pressed")!=="true";
  b.disabled=true;
  interestQueue=interestQueue.then(function(){
    return post("/api/interest/",{id:S.sid,role:role,team:team,interested:on})
      .then(function(j){S.interests=j.interests||[];save();refreshInterestButtons();})
      .catch(function(err){b.disabled=false;emailState="error";emailMsg=err.message;updateActions();});
  });
}

function updateActions(){var a=document.getElementById("sg-actions");if(a)a.innerHTML=actionsHtml();}

function post(url,body){
  return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)})
    .then(function(r){return r.json().catch(function(){return {};}).then(function(j){if(!r.ok)throw new Error(j.error||"Something went wrong. Please try again.");return j;});});
}

function submitResults(){
  if(S.sid||saveState==="saving"||!S.who)return;
  saveState="saving";updateActions();
  post("/api/submit/",{name:S.who.name,email:S.who.email,phone:S.who.phone,website:S.who.website||"",answers:S.g,results:summary()})
    .then(function(j){S.sid=j.id;S.interests=[];save();saveState="saved";updateActions();refreshInterestButtons();})
    .catch(function(err){saveState="error";saveError=err.message||"We couldn’t save your results.";updateActions();});
}

function emailResults(){
  if(!S.sid||emailState==="sending")return;
  emailState="sending";updateActions();
  post("/api/email-results/",{id:S.sid})
    .then(function(j){emailState="sent";emailMsg="Sent! Check "+(j.email||"your inbox")+" in the next few minutes (and your spam folder).";updateActions();})
    .catch(function(err){emailState="error";emailMsg=err.message;updateActions();});
}

function readWho(form){
  var f=form.elements, e=document.getElementById("who-error");
  var who={name:f.name.value.trim(),email:f.email.value.trim(),phone:f.phone.value.trim(),website:f.website.value};
  var err="", field=null;
  if(!who.name){err="Enter your name.";field=f.name;}
  else if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(who.email)){err="Enter a valid email address.";field=f.email;}
  else{var digits=who.phone.replace(/\D/g,"");if(digits.length<7||digits.length>15){err="Enter a valid phone number.";field=f.phone;}}
  [f.name,f.email,f.phone].forEach(function(x){x.removeAttribute("aria-invalid");});
  if(err){e.textContent=err;field.setAttribute("aria-invalid","true");field.focus();return null;}
  e.textContent="";
  return who;
}

function render(){
  var h;
  if(!S.started||!S.who)h=viewIntro();
  else if(S.i>=TOTAL)h=viewResults();
  else h=viewGift();
  root.innerHTML=h;
  var f=document.getElementById("focus");
  if(f){try{f.focus({preventScroll:true});}catch(e){}}
  if(S.started&&S.i>=TOTAL&&!S.sid)submitResults();
}
function go(delta){S.i=Math.max(0,Math.min(TOTAL,S.i+delta));confirmReset=false;save();render();window.scrollTo(0,0);}

var lock=false;
root.addEventListener("click",function(e){
  var b=e.target.closest("[data-act]"); if(!b)return;
  var act=b.getAttribute("data-act");
  if(act==="start"){S.started=true;save();render();window.scrollTo(0,0);}
  else if(act==="rate"){
    if(lock)return; var it=ITEMS[S.i]; S.g[ikey(it)]=parseInt(b.getAttribute("data-v"),10); save(); render();
    lock=true; setTimeout(function(){lock=false;go(1);},220);
  }
  else if(act==="next"){go(1);}
  else if(act==="back"){go(-1);}
  else if(act==="print"){try{window.print();}catch(err){}}
  else if(act==="email"){emailResults();}
  else if(act==="interest"){toggleInterest(b);}
  else if(act==="resubmit"){submitResults();}
  else if(act==="restart"){
    var needConfirm=S.i>=TOTAL;
    if(needConfirm&&!confirmReset){confirmReset=true;updateActions();return;}
    S={started:false,i:0,g:{},d:{},who:S.who,interests:[]};confirmReset=false;saveState="idle";emailState="idle";save();render();window.scrollTo(0,0);
  }
});

root.addEventListener("submit",function(e){
  if(e.target.id!=="who-form")return;
  e.preventDefault();
  var who=readWho(e.target); if(!who)return;
  S.who=who;S.started=true;save();render();window.scrollTo(0,0);
});

render();
</script>
