shuffle(ITEMS,rng(20261));
function grp(it){return it.kind==="g"?"g"+it.g:"d"+it.k;}
function ikey(it){return it.kind==="g"?it.g+"-"+it.s:"d"+it.k+"-"+it.s;}
for(var a=1;a<ITEMS.length;a++){
  if(grp(ITEMS[a])===grp(ITEMS[a-1])){
    var b=a+1; while(b<ITEMS.length&&grp(ITEMS[b])===grp(ITEMS[a-1]))b++;
    if(b<ITEMS.length){var tmp=ITEMS[a];ITEMS[a]=ITEMS[b];ITEMS[b]=tmp;}
  }
}
