function compute(){
  var gifts=GIFTS.map(function(g,gi){var sum=0;for(var s=0;s<4;s++)sum+=(S.g[gi+"-"+s]||0);return {g:g,sum:sum,pct:Math.round((sum-4)/16*100)};});
  gifts.sort(function(a,b){return b.sum-a.sum||a.g.name.localeCompare(b.g.name);});
  var sums={D:0,I:0,S:0,C:0};
  ["D","I","S","C"].forEach(function(k){for(var q=0;q<DISC[k].length;q++)sums[k]+=(S.g["d"+k+"-"+q]||0);});
  var mean=(sums.D+sums.I+sums.S+sums.C)/4;
  var disc=["D","I","S","C"].map(function(k){var rel=sums[k]-mean;return {k:k,raw:rel,pct:Math.round(Math.max(0,Math.min(100,50+rel/10*50)))};});
  var ranked=disc.slice().sort(function(a,b){return b.raw-a.raw;});
  return {gifts:gifts,disc:disc,ranked:ranked};
}

