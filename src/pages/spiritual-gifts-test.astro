    h+='<h3 style="margin:30px 0 12px">The rest of our serving teams</h3>';
    order.forEach(function(team){
      h+='<div class="card"><h3>'+(TEAM_PAGES[team]?'<a class="team-head" href="'+TEAM_PAGES[team]+'">'+esc(team)+' <span aria-hidden="true">→</span></a>':esc(team))+'</h3>'+
        (TEAM_ABOUT[team]&&!(groups[team].length===1&&groups[team][0].t.role===team)?'<p class="team-blurb">'+esc(TEAM_ABOUT[team])+'</p>':'');
      groups[team].forEach(function(m){
        h+='<div class="rest-role">'+(m.t.role!==team?'<b>'+esc(m.t.role)+'</b> ':'')+
          (m.t.description?'<span class="muted">'+esc(m.t.description)+'</span>':'')+
          '<div class="interest-wrap" data-key="'+esc(m.t.team+"|"+m.t.role)+'">'+interestBtn(m)+'</div></div>';
      });
      h+='</div>';
    });
    h+='</div>';
  }

  h+='<p class="note">This is a tool for reflection, not a diagnosis, and it is not a formal or validated assessment. '+esc(CONFIG.followUp)+'</p>'+
     '<div class="noprint" id="sg-actions">'+actionsHtml()+'</div></div>';
  return h;
}

var saveState="idle", saveError="", emailState="idle", emailMsg="";

function actionsHtml(){
  var email=S.who&&S.who.email?S.who.email:"";
  var status="";
  if(saveState==="saving")status='<p class="status">Saving your results…</p>';
  else if(saveState==="error")status='<p class="status err">'+esc(saveError)+' <button class="linkbtn" data-act="resubmit">Try again</button></p>';
  if(emailState==="sent")status+='<p class="status ok">'+esc(emailMsg)+'</p>';
  else if(emailState==="error")status+='<p class="status err">'+esc(emailMsg)+'</p>';
  var canEmail=!!S.sid&&emailState!=="sending";
  return '<div aria-live="polite">'+status+'</div>'+
   '<div class="row" style="margin-top:16px">'+
    '<button class="btn" data-act="email"'+(canEmail?'':' disabled')+'>'+(emailState==="sending"?"Sending…":"Email my results")+'</button>'+
    '<button class="btn ghost" data-act="print">Download or print</button>'+
    '<button class="btn ghost" data-act="restart">'+(confirmReset?"Tap again to erase and retake":"Retake the test")+'</button>'+
   '</div>'+
   (email?'<p class="muted small">Email goes to '+esc(email)+'.</p>':'');
}

function refreshInterestButtons(){
  [].slice.call(document.querySelectorAll('.interest-wrap')).forEach(function(w){
    var key=w.getAttribute("data-key"), i=key.indexOf("|");
    w.innerHTML=interestBtn({t:{team:key.slice(0,i),role:key.slice(i+1)}});
  });
}

// Taps go to the server one at a time so the combined staff email always reflects the latest list.
var interestQueue=Promise.resolve();
function toggleInterest(b){
  if(!S.sid||b.disabled)return;
  var role=b.getAttribute("data-role"), team=b.getAttribute("data-team"), on=b.getAttribute("aria-pressed")!=="true";
  b.disabled=true;
  interestQueue=interestQueue.then(function(){
    return post("/api/interest/",{id:S.sid,role:role,team:team,interested:on})
      .then(function(j){S.interests=j.interests||[];save();refreshInterestButtons();})
      .catch(function(err){b.disabled=false;emailState="error";emailMsg=err.message;updateActions();});
  });
}

function savePassionNote(){var t=document.getElementById("passion-note");if(t){S.passionNote=t.value.slice(0,500);save();}}

function updateActions(){var a=document.getElementById("sg-actions");if(a)a.innerHTML=actionsHtml();}

function post(url,body){
  return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)})
    .then(function(r){return r.json().catch(function(){return {};}).then(function(j){if(!r.ok)throw new Error(j.error||"Something went wrong. Please try again.");return j;});});
}

function submitResults(){
  if(S.sid||saveState==="saving"||!S.who)return;
  saveState="saving";updateActions();
  post("/api/submit/",{name:S.who.name,email:S.who.email,phone:S.who.phone,website:S.who.website||"",answers:S.g,results:summary()})
    .then(function(j){S.sid=j.id;S.interests=[];save();saveState="saved";updateActions();refreshInterestButtons();})
    .catch(function(err){saveState="error";saveError=err.message||"We couldn’t save your results.";updateActions();});
}

function emailResults(){
  if(!S.sid||emailState==="sending")return;
  emailState="sending";updateActions();
  post("/api/email-results/",{id:S.sid})
    .then(function(j){emailState="sent";emailMsg="Sent! Check "+(j.email||"your inbox")+" in the next few minutes (and your spam folder).";updateActions();})
    .catch(function(err){emailState="error";emailMsg=err.message;updateActions();});
}

function readWho(form){
  var f=form.elements, e=document.getElementById("who-error");
  var who={name:f.name.value.trim(),email:f.email.value.trim(),phone:f.phone.value.trim(),website:f.website.value};
  var err="", field=null;
  if(!who.name){err="Enter your name.";field=f.name;}
  else if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(who.email)){err="Enter a valid email address.";field=f.email;}
  else{var digits=who.phone.replace(/\D/g,"");if(digits.length<7||digits.length>15){err="Enter a valid phone number.";field=f.phone;}}
  [f.name,f.email,f.phone].forEach(function(x){x.removeAttribute("aria-invalid");});
  if(err){e.textContent=err;field.setAttribute("aria-invalid","true");field.focus();return null;}
  e.textContent="";
  return who;
}

function viewPassions(){
  var sel=S.passions||[];
  return '<div class="prog"><div class="prog-meta"><span class="part">Last step</span><span>Almost done</span></div>'+
   '<div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100"><span style="width:100%"></span></div></div>'+
   '<div class="q passions"><h2 tabindex="-1" id="focus">What do you enjoy?</h2>'+
   '<p class="hint" style="margin:-12px 0 18px">Tap anything that sounds like you. Pick as many as you like, or none.</p>'+
   '<div class="chips" role="group" aria-label="Things you enjoy">'+
   PASSIONS.map(function(p){var on=sel.indexOf(p.id)>=0;
     return '<button class="chip" data-act="passion" data-id="'+p.id+'" aria-pressed="'+on+'">'+(on?'<span aria-hidden="true">✓</span>':'')+esc(p.label)+'</button>';}).join('')+
   '</div>'+
   '<label class="note-label" for="passion-note">Anything else you’re passionate about? <span class="muted">(optional)</span></label>'+
   '<textarea id="passion-note" maxlength="500" rows="3" placeholder="For example: gardening, spreadsheets, cooking for a crowd, sign language…">'+esc(S.passionNote||"")+'</textarea>'+
   '<div class="nav"><button class="btn ghost" data-act="back">Back</button><button class="btn" data-act="finish">See my results</button></div></div>';
}

function render(){
  var h;
  if(!S.started||!S.who)h=viewIntro();
  else if(S.i>=TOTAL&&!S.pdone&&!S.sid)h=viewPassions();
  else if(S.i>=TOTAL)h=viewResults();
  else h=viewGift();
  root.innerHTML=h;
  var f=document.getElementById("focus");
  if(f){try{f.focus({preventScroll:true});}catch(e){}}
  if(S.started&&S.i>=TOTAL&&(S.pdone||S.sid)&&!S.sid)submitResults();
}
// Keep the test in one spot: line its top up just under the sticky site header instead of jumping to the page top.
function toQuizTop(){
  var el=document.getElementById("sg"), header=document.querySelector("body>header");
  if(!el)return;
  var y=el.getBoundingClientRect().top+window.scrollY-(header?header.offsetHeight:0);
  window.scrollTo(0,Math.max(0,y));
}
function go(delta){S.i=Math.max(0,Math.min(TOTAL,S.i+delta));confirmReset=false;save();render();toQuizTop();}

var lock=false;
root.addEventListener("click",function(e){
  var b=e.target.closest("[data-act]"); if(!b)return;
  var act=b.getAttribute("data-act");
  if(act==="start"){S.started=true;save();render();toQuizTop();}
  else if(act==="rate"){
    if(lock)return; var it=ITEMS[S.i]; S.g[ikey(it)]=parseInt(b.getAttribute("data-v"),10); save(); render();
    lock=true; setTimeout(function(){lock=false;go(1);},220);
  }
  else if(act==="next"){go(1);}
  else if(act==="back"){if(S.i>=TOTAL){savePassionNote();}go(-1);}
  else if(act==="passion"){
    var id=b.getAttribute("data-id");S.passions=S.passions||[];
    var k=S.passions.indexOf(id);if(k>=0)S.passions.splice(k,1);else S.passions.push(id);
    var on=k<0;b.setAttribute("aria-pressed",String(on));
    b.innerHTML=(on?'<span aria-hidden="true">✓</span>':'')+esc(PASSIONS.filter(function(p){return p.id===id;})[0].label);
    save();
  }
  else if(act==="finish"){savePassionNote();S.pdone=true;save();render();toQuizTop();}
  else if(act==="print"){try{window.print();}catch(err){}}
  else if(act==="email"){emailResults();}
  else if(act==="interest"){toggleInterest(b);}
  else if(act==="resubmit"){submitResults();}
  else if(act==="restart"){
    var needConfirm=S.i>=TOTAL;
    if(needConfirm&&!confirmReset){confirmReset=true;updateActions();return;}
    S={started:false,i:0,g:{},d:{},who:S.who,interests:[],passions:[],passionNote:""};confirmReset=false;saveState="idle";emailState="idle";save();render();toQuizTop();
  }
});

root.addEventListener("submit",function(e){
  if(e.target.id!=="who-form")return;
  e.preventDefault();
  var who=readWho(e.target); if(!who)return;
  S.who=who;S.started=true;save();render();toQuizTop();
});

render();
</script>
