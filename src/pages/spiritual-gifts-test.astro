function whyText(m){
  var parts=[];
  if(m.best.length)parts.push("your gifts in "+m.best.join(" and "));
  if(m.passions.length)parts.push("your interest in "+m.passions.map(function(p){return p.short;}).join(" and "));
  return parts.length?"Fits "+parts.join(" and ")+".":"";
}

function teamMatches(R){
  var gp={};R.gifts.forEach(function(x){gp[x.g.id]=x;});
  var dp={};R.disc.forEach(function(x){dp[x.k]=x.pct;});
  return TEAMS.map(function(t){
    var gl=(t.gifts||[]).map(function(id){return gp[id];}).filter(Boolean);
    var wts=[1,0.8,0.6,0.5,0.4],wsum=0,gAvg=0;gl.forEach(function(x,i){var w=wts[Math.min(i,4)];gAvg+=x.pct*w;wsum+=w;});gAvg=wsum?gAvg/wsum:0;
    var gMax=gl.length?Math.max.apply(null,gl.map(function(x){return x.pct;})):0;
    var gScore=gl.length?(0.6*gAvg+0.4*gMax):0;
    var ds=(t.disc||[]).map(function(k){return dp[k];}).filter(function(v){return v!=null;});
    var dScore=ds.length?ds.reduce(function(s,v){return s+v;},0)/ds.length:50;
    // Only name gifts the person actually scored well in.
    var best=gl.filter(function(x){return x.pct>=60;}).sort(function(a,b){return b.sum-a.sum;}).slice(0,2).map(function(x){return x.g.name;});
    var ps=passionsFor(t);
    return {t:t,score:0.75*gScore+0.25*dScore+(ps.length?PASSION_BONUS:0),best:best,passions:ps};
  }).sort(function(a,b){return b.score-a.score;}).filter(function(m,i,all){
    // A role listed more than once (different gift paths) keeps only its best-scoring entry.
    for(var j=0;j<i;j++)if(all[j].t.team===m.t.team&&all[j].t.role===m.t.role)return false;
    return true;
  });
}

function pickRoles(R){
  var all=teamMatches(R),cnt={},M=[],used={};
  all.forEach(function(m){if(M.length<3&&(cnt[m.t.team]||0)<2){cnt[m.t.team]=(cnt[m.t.team]||0)+1;M.push(m);used[m.t.team+"|"+m.t.role]=1;}});
  // Anyone who tapped an interest always sees at least one suggestion from it.
  if(M.length===3&&!M.some(function(m){return m.passions.length;})){
    var last=M[2], pick=null;
    all.forEach(function(m){if(!pick&&m.passions.length&&!used[m.t.team+"|"+m.t.role]&&(cnt[m.t.team]||0)-(last.t.team===m.t.team?1:0)<2)pick=m;});
    if(pick){delete used[last.t.team+"|"+last.t.role];M[2]=pick;used[pick.t.team+"|"+pick.t.role]=1;}
  }
  return {all:all,M:M,used:used};
}

