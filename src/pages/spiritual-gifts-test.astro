---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Spiritual Gifts Test" description="Discover your spiritual gifts and personality style, and find the City Church Lufkin serve roles that fit you best.">

  <!-- HERO -->
  <section class="sg-hero relative overflow-hidden py-20" style="background: linear-gradient(160deg, #0A1220 0%, #101B2E 60%, #1A2E5C 100%);">
    <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="dot-gifts" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <rect x="14" y="14" width="4" height="4" rx="1" fill="#8CC640" opacity="0.10" transform="rotate(45 16 16)"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#dot-gifts)"/>
    </svg>
    <div class="absolute left-0 top-0 bottom-0 w-1" style="background: linear-gradient(180deg, transparent, #8CC640 30%, #8CC640 70%, transparent);"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="section-label">Find Your Fit</div>
      <h1 class="display-lg text-white mt-2">Spiritual Gifts <span style="color: #8CC640;">Test</span></h1>
      <p class="mt-4 text-lg text-white/60 max-w-xl">Discover how God has wired you, your personality style, and the serve roles that fit you best.</p>
    </div>
  </section>

  <section class="px-4 sm:px-6 lg:px-8">
    <div id="sg">
      <div class="wrap" id="sg-root"></div>
    </div>
  </section>

</BaseLayout>

<style is:global>
#sg{
  --surface:#FFFFFF; --ink:#101B2E; --muted:#5A6275; --line:#E3E6EC;
  --brand:#8CC640; --brand-dark:#6FA32E; --soft:#F0F9E0; --track:#E8ECF3; --navy-mid:#3A5490;
  color:var(--ink);
}
#sg .wrap{max-width:680px;margin:0 auto;padding:40px 0 24px}
#sg h2,#sg h3{margin:0;color:var(--ink)}
#sg .sg-title{font-weight:900;text-transform:uppercase;font-size:clamp(2.1rem,6vw,3rem);line-height:.95;letter-spacing:.01em}
#sg .q h2{font-weight:700;font-size:clamp(1.6rem,5vw,2.25rem);line-height:1.15}
#sg h3{font-weight:800;text-transform:uppercase;font-size:1.35rem;line-height:1.1;letter-spacing:.01em}
#sg p{margin:0 0 .9em;line-height:1.65}
#sg .muted{color:var(--muted)}
#sg h2:focus{outline:none}
#sg button{font:inherit;color:inherit;cursor:pointer}

#sg .intro .sg-title{margin-bottom:18px}
#sg .lede{font-size:1.1rem;max-width:36rem}
#sg .facts{list-style:none;padding:0;margin:26px 0;display:grid;gap:12px}
#sg .facts li{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:12px;padding:14px 16px;box-shadow:0 2px 8px -1px rgba(16,27,46,0.08),0 1px 2px -1px rgba(16,27,46,0.04)}
#sg .facts b{font-family:"Barlow Condensed",sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.02em;font-size:1.1rem}

#sg .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:50px;padding:0 26px;border-radius:.25rem;border:2px solid var(--brand);background:var(--brand);color:#fff;font-weight:600;font-size:.875rem;text-transform:uppercase;letter-spacing:.1em;box-shadow:0 4px 14px -2px rgba(140,198,64,0.40);transition:transform .2s cubic-bezier(0.22,1,0.36,1)}
#sg .btn:hover{background:var(--brand-dark);border-color:var(--brand-dark);transform:translateY(-1px)}
#sg .btn:active{transform:translateY(0)}
#sg .btn.ghost{background:transparent;color:var(--ink);border-color:var(--line);box-shadow:none}
#sg .btn.ghost:hover{border-color:var(--ink);background:transparent}
#sg .btn[disabled]{opacity:.45;cursor:not-allowed}
#sg .btn[disabled]:hover{transform:none;background:var(--brand);border-color:var(--brand)}
#sg .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}

#sg .prog{position:sticky;top:64px;background:#FAFAFA;padding:14px 0 12px;z-index:5}
#sg .prog-meta{display:flex;justify-content:space-between;font-size:.85rem;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.08em;font-weight:600}
#sg .bar{height:8px;border-radius:999px;background:var(--track);overflow:hidden}
#sg .bar>span{display:block;height:100%;background:var(--brand);border-radius:999px}
#sg .part{color:var(--ink)}

#sg .q{padding-top:22px}
#sg .q h2{margin-bottom:26px}
#sg .opts{display:grid;gap:10px}
#sg .opt{display:flex;align-items:center;gap:14px;width:100%;min-height:58px;padding:12px 16px;text-align:left;background:var(--surface);border:2px solid var(--line);border-radius:12px;font-weight:500;box-shadow:0 1px 4px rgba(16,27,46,0.06);transition:transform .2s cubic-bezier(0.22,1,0.36,1)}
#sg .opt:hover{border-color:#B0BCDD;transform:translateY(-1px)}
#sg .opt:active{transform:scale(.99)}
#sg .opt[aria-pressed="true"]{border-color:var(--brand);background:var(--soft)}
#sg .dots{display:inline-flex;gap:4px;flex:none}
#sg .dots i{width:9px;height:9px;border-radius:50%;background:var(--track);display:block}
#sg .dots i.on{background:var(--brand)}
#sg .nav{display:flex;justify-content:space-between;gap:12px;margin-top:22px}

#sg .res .sg-title{margin-bottom:12px}
#sg .sec{margin-top:44px}
#sg .sec>h2{margin-bottom:14px;font-weight:900;text-transform:uppercase;font-size:1.9rem;line-height:1;letter-spacing:.01em}
#sg .card{border-color:var(--line);border-radius:12px;padding:18px 18px 16px;margin-bottom:12px}
#sg .card:hover{transform:none;border-color:var(--line);box-shadow:0 2px 8px -1px rgba(16,27,46,0.08),0 1px 2px -1px rgba(16,27,46,0.04)}
#sg .card.top{border-left:6px solid var(--brand)}
#sg .card .meta{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:8px}
#sg .card .score{font-size:.85rem;color:var(--muted);white-space:nowrap;font-weight:600}
#sg .card .ref{font-size:.85rem;color:var(--muted);margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:600}
#sg .card p{margin:8px 0 6px}
#sg .meter{height:10px;border-radius:999px;background:var(--track);overflow:hidden}
#sg .meter>span{display:block;height:100%;border-radius:999px;background:var(--navy-mid)}
#sg .card.top .meter>span{background:var(--brand)}
#sg .list{display:grid;gap:10px;margin:0;padding:0;list-style:none}
#sg .list li{font-size:.95rem}
#sg .list summary{display:grid;grid-template-columns:9.5rem 1fr 2.6rem;gap:10px;align-items:center;cursor:pointer;list-style:none;padding:4px 0;border-radius:6px}
#sg .list summary::-webkit-details-marker{display:none}
#sg .list summary:hover b{color:var(--brand-dark)}
#sg .list summary:active{opacity:.7}
#sg .list li b{font-weight:600;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
#sg .list li em{font-style:normal;color:var(--muted);text-align:right}
#sg .gift-body .ref{font-size:.85rem;color:var(--muted);margin:0;text-transform:uppercase;letter-spacing:.08em;font-weight:600}
#sg .gift-body{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:8px 0 6px}
#sg .def{font-weight:600}
#sg .signs-h{font-family:"Barlow Condensed",sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.04em;font-size:1rem;margin:12px 0 6px !important}
#sg .signs{margin:0 0 10px;padding-left:1.2rem;list-style:disc;display:grid;gap:4px;font-size:.95rem}
#sg .serves{list-style:none;margin:0 0 10px;padding:0;display:grid;gap:4px;font-size:.95rem}
#sg .serves a{color:var(--ink);font-weight:600;text-decoration:underline;text-decoration-color:var(--brand);text-underline-offset:3px}
#sg .serves a:hover{color:var(--brand-dark)}
#sg .serves a:active{opacity:.7}
#sg .team-actions{display:flex;flex-wrap:wrap;align-items:flex-start;gap:10px 18px;margin-top:10px}
#sg .team-actions .team-link{margin-top:0;min-height:42px}
#sg .btn.interest{min-height:42px;padding:0 18px;font-size:.8rem}
#sg .btn.interest[aria-pressed="true"]{box-shadow:none}
#sg .interest-note{font-size:.85rem;color:var(--brand-dark);font-weight:600;margin:6px 0 0}
@media print{#sg .team-actions{display:none}}
#sg details.more{margin:6px 0 10px}
#sg details.more summary{cursor:pointer;font-weight:600;color:var(--brand-dark);font-size:.9rem}
#sg details.more summary:hover{text-decoration:underline;text-underline-offset:3px}
#sg details.more summary:active{opacity:.7}
#sg details.all{margin-top:6px}
#sg details.all > summary{cursor:pointer;font-weight:600;padding:10px 0;color:var(--brand-dark)}
#sg .disc-head{display:flex;align-items:baseline;gap:14px;margin-bottom:6px}
#sg .disc-head .big{font-family:"Barlow Condensed",sans-serif;font-weight:900;font-size:3.6rem;line-height:1;color:var(--brand-dark)}
#sg .disc-bars{display:grid;gap:12px;margin:18px 0}
#sg .disc-bars .r{display:grid;grid-template-columns:5.5rem 1fr 2.6rem;gap:10px;align-items:center;font-size:.95rem}
#sg .disc-bars .r em{font-style:normal;color:var(--muted);text-align:right}
#sg .note{font-size:.9rem;color:var(--muted);border-top:1px solid var(--line);padding-top:16px;margin-top:36px}
#sg .team .why{font-size:.95rem;color:var(--muted)}
#sg .roles{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:8px}
#sg .roles li{font-size:.95rem}
#sg .team-about{font-size:.9rem;color:var(--muted);background:#F6F8FB;border-radius:8px;padding:10px 12px;margin:10px 0 4px}
#sg .team-about b{color:var(--ink);font-weight:700}
#sg .card.combo{border-left:6px solid var(--navy-mid)}
#sg .card.combo h3 .plus{color:var(--brand-dark);margin:0 .15em}
#sg .card.combo p{margin:6px 0 0}
#sg .rest-role{padding:10px 0;border-top:1px solid var(--line);font-size:.95rem}
#sg .rest-role:first-of-type{border-top:0}
#sg .rest-role .interest-wrap{margin-top:8px}
#sg .team-blurb{font-size:.9rem;color:var(--muted);margin:4px 0 10px;font-style:italic}
#sg .team-link{display:inline-flex;align-items:center;gap:.4rem;margin-top:6px;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--brand-dark);text-decoration:none}
#sg .team-link span,#sg .team-head span{display:inline-block;transition:transform .2s cubic-bezier(0.22,1,0.36,1)}
#sg .team-link:hover span,#sg .team-head:hover span{transform:translateX(3px)}
#sg .team-link:hover{text-decoration:underline;text-underline-offset:3px}
#sg .team-link:active span,#sg .team-head:active span{transform:translateX(1px)}
#sg .team-head{color:inherit;text-decoration:none}
#sg .team-head span{color:var(--brand-dark)}
#sg .team-head:hover{color:var(--brand-dark)}
@media print{#sg .team-link{display:none}}

#sg .who{margin-top:28px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:22px 20px;box-shadow:0 2px 8px -1px rgba(16,27,46,0.08),0 1px 2px -1px rgba(16,27,46,0.04)}
#sg .who h3{margin-bottom:4px}
#sg .who > .muted{margin-bottom:18px;font-size:.95rem}
#sg .field{margin-bottom:14px}
#sg .field label{display:block;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
#sg .field input{width:100%;min-height:48px;padding:10px 14px;border:2px solid var(--line);border-radius:10px;font:inherit;font-size:1rem;color:var(--ink);background:#fff}
#sg .field input:hover{border-color:#B0BCDD}
#sg .field input:focus-visible{outline:2px solid var(--brand);outline-offset:2px;border-color:var(--brand)}
#sg .field input[aria-invalid="true"]{border-color:#C41C35}
#sg .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
#sg .form-error{color:#C41C35;font-weight:600;font-size:.95rem;margin:0}
#sg .form-error:empty{display:none}
#sg .form-error:not(:empty){margin-bottom:12px}
#sg .privacy{font-size:.85rem;color:var(--muted);margin:4px 0 18px}
#sg .status{margin:16px 0 0;font-size:.95rem;font-weight:600;color:var(--muted)}
#sg .status.ok{color:var(--brand-dark)}
#sg .status.err{color:#C41C35}
#sg .small{font-size:.85rem;margin-top:10px}
#sg .linkbtn{background:none;border:0;padding:0;font-weight:700;text-decoration:underline;text-underline-offset:3px;color:inherit}
#sg .linkbtn:hover{color:var(--ink)}
#sg .linkbtn:active{opacity:.7}

@media (max-width:420px){
  #sg .list summary{grid-template-columns:7.4rem 1fr 2.4rem}
}
@media print{
  body>header,body>footer,.sg-hero,#sg .prog,#sg .nav,#sg .noprint{display:none !important}
  body{background:#fff}
  #sg .card,#sg .facts li{break-inside:avoid;box-shadow:none;border-color:#999}
}
@media (prefers-reduced-motion:reduce){#sg *{transition:none !important}}
</style>

<script is:inline>
/* ===================== SETTINGS (edit these) ===================== */
var CONFIG = {
  churchName: "City Church",   // e.g. "City Church". Shown on the intro and results pages when filled in.
  followUp: "Take your results to a staff member or team leader. Ask the people who know you whether they see these gifts in you too."
};

/* Serve teams. Add teams here and a "Where you could serve" section appears in the results.
   gifts: gift ids from the GIFTS list below. disc: any of "D","I","S","C" (optional).
   Example:
   add("Impressions", "Greeter", "Welcomes people warmly.", ["hospitality","mercy","service"], ["I","S"])   (list the most important gift first)
*/
var TEAMS = [];
var TEAM_ABOUT = {
 "Worship":"Leading the church into the presence of God through music, song, and authentic worship.",
 "Kid City":"Reaching the next generation — creating a safe, fun, and transformative environment for every child at City Church Lufkin.",
 "Production":"Running audio, video, presentation, and livestream so nothing gets in the way of the message.",
 "Impressions":"Setting the tone for every person's experience — from the parking lot to the pew.",
 "Care Team":"Serving the City Church family through practical love — meals, presence, and care during life's hardest moments.",
 "Prayer Team":"Covering City Church in prayer — before every service, at the altar, and through every request submitted by the congregation.",
 "Creative Team":"Telling the City Church story through photography, video, graphics, and social media.",
 "Safety Team":"Ensuring City Church is one of the safest places in Lufkin — for every family, guest, and team member.",
 "Student Ministry":"Creating a fun, safe, and spiritually rich environment where Jr High and High School students encounter Jesus and find their place.",
 "Outreach":"Mobilizing City Church to serve locally and globally — a giving, going church.",
 "Next Steps":"Helping new people connect deeply to City Church through a personal, intentional pathway.",
 "Life Groups":"Where people grow, belong, and do life together — in every season.",
 "Milestones":"Facilitating the sacred moments of Water Baptism and Communion with care and intentionality.",
 "Facilities":"Keeping City Church's spaces clean, safe, and ready for ministry — every single week."
};
var TEAM_PAGES = {
 "Worship":"/teams/worship/",
 "Kid City":"/teams/kid-city/",
 "Production":"/teams/production/",
 "Impressions":"/teams/impressions/",
 "Care Team":"/teams/care/",
 "Prayer Team":"/teams/prayer/",
 "Creative Team":"/teams/creative/",
 "Safety Team":"/teams/safety/",
 "Student Ministry":"/teams/student-ministry/",
 "Outreach":"/teams/outreach/",
 "Next Steps":"/teams/next-steps/",
 "Life Groups":"/teams/life-groups/",
 "Milestones":"/teams/milestones/",
 "Facilities":"/teams/facilities/"
};
(function(){
 function add(team,role,description,gifts,disc){TEAMS.push({team:team,role:role,description:description,gifts:gifts,disc:disc});}
 // One suggestion per team; each [gifts, disc] path is a different kind of person who fits it, and the best path wins.
 function team(team,role,description,paths){paths.forEach(function(p){add(team,role,description,p[0],p[1]);});}
 team("Worship","Worship","Sing or play on the worship team, or help lead and organize the band.",[
  [["music","leadership","prophecy"],["D","I"]],
  [["music","administration","leadership"],["C","D"]],
  [["music","helps"],["I","S"]],
  [["music","helps","craftsmanship"],["S","C"]]]);
 add("Kid City","Mini City: Nursery, Toddlers & Preschool","Cares for our youngest kids, from babies through preschool, with patience, play, and the love of Jesus.",["mercy","helps","shepherding","service"],["S","I"]);
 add("Kid City","Kid City Check-In","The friendly first face for families: checks kids in, greets them, and eases the stress of drop-off.",["hospitality","mercy","service"],["I","S"]);
 add("Kid City","Kid City Teacher","Teaches Bible lessons to kids in a way that's fun, clear, and true.",["teaching","shepherding","mercy","exhortation"],["I","S"]);
 add("Kid City","Kid City Room Helper","Assists in kids rooms with activities, supervision, and care.",["helps","service","mercy"],["S","I"]);
 team("Production","Production","Run sound, slides, cameras, or the livestream so nothing gets in the way of the message.",[
  [["craftsmanship","helps","service"],["C","S"]],
  [["helps","service","administration"],["C","S"]],
  [["administration","leadership","craftsmanship"],["D","C"]]]);
 team("Impressions","Impressions","Welcome people from the parking lot to their seat: greeting, ushering, the coffee bar, or the connections table.",[
  [["hospitality","mercy","service","evangelism"],["I","S"]],
  [["service","helps","hospitality"],["S","C"]],
  [["hospitality","exhortation","shepherding","evangelism"],["I","S"]],
  [["service","hospitality","helps"],["S","I"]]]);
 team("Care Team","Care Team","Practical love during life's hardest moments.",[
  [["mercy","shepherding","helps","giving","exhortation"],["S","I"]]]);
 team("Prayer Team","Prayer Team","Pray before services, with people at the altar, or over the prayer requests our church submits.",[
  [["intercession","faith","prophecy"],["S","C"]],
  [["intercession","mercy","exhortation","healing","faith"],["S","I"]],
  [["intercession","mercy","administration"],["S","C"]]]);
 team("Creative Team","Creative Team","Tell the City Church story through photos, video, graphics, writing, and social media.",[
  [["craftsmanship","service"],["C","I"]],
  [["craftsmanship"],["C","I"]],
  [["craftsmanship","evangelism","administration"],["I","C"]]]);
 team("Safety Team","Safety Team","Keeps every guest safe, from watching over the building to helping when someone needs medical attention.",[
  [["helps","service","discernment","mercy","wisdom"],["C","S"]]]);
 team("Student Ministry","Student Ministry Volunteer","Comes alongside our student leaders to love, support, and connect with students, and sometimes to teach.",[
  [["shepherding","mercy","exhortation","helps","teaching"],["I","S"]]]);
 team("Outreach","Outreach","Help City Church give and go, from local serve weekends to global outreach.",[
  [["missionary","apostleship","leadership","evangelism","giving"],["D","I"]],
  [["service","evangelism","giving","helps"],["I","S"]]]);
 team("Next Steps","Next Steps Event Team","Helps host the Next Steps partnership event: meeting new people, setting up and tearing down, and taking part in the event.",[
  [["hospitality","helps","service","exhortation","shepherding"],["I","S"]]]);
 team("Life Groups","Life Group Leader","Leads a Bible study or interest group: hosts, guides the discussion, and builds community and discipleship.",[
  [["shepherding","hospitality","teaching","leadership","exhortation"],["I","S"]]]);
 team("Milestones","Milestones","Help prepare for and serve at baptisms and communion, two of the sacred moments of the church.",[
  [["helps","service","shepherding","mercy"],["S"]],
  [["service","helps","intercession"],["S","C"]]]);
 team("Facilities","Facilities","Cares for our building so it's ready for ministry every week. This may include cleaning, repairs, and general upkeep.",[
  [["service","helps"],["S","C"]],
  [["craftsmanship"],["S","C"]]]);
})();

/* ===================== GIFTS ===================== */
var GIFTS = [
 {id:"administration",name:"Administration",ref:"1 Corinthians 12:28",def:"The Spirit-given ability to organize people, resources, and plans so that ministry actually happens.",q:[
  "I enjoy turning a big, messy idea into a clear plan with steps and deadlines.",
  "I notice what people, supplies, and time an event will need before anyone asks.",
  "When a ministry feels disorganized, I feel driven to build a better system for it.",
  "People have told me I'm the one who makes things run smoothly."]},
 {id:"apostleship",name:"Apostleship",ref:"Ephesians 4:11",def:"The Spirit-given ability to start new works, pioneering churches, ministries, and gospel outposts where nothing exists yet.",q:[
  "I get excited about starting something new where nothing exists yet.",
  "I feel pulled toward launching new churches, ministries, or outreach efforts.",
  "I'm comfortable taking risks to open new ground for the gospel.",
  "Others have recognized me as someone who gets new works started and then trains others to carry them on."]},
 {id:"craftsmanship",name:"Craftsmanship",ref:"Exodus 31:1-5",def:"The Spirit-given ability to design and build with your hands for the glory of God: wood, metal, fabric, paint, pixels, and stages.",q:[
  "I love making things with my hands or with design tools for the church to use.",
  "I can picture how a stage, set, or space should look and then bring it to life.",
  "I take real pride in careful, well-made work that honors God.",
  "People have said something I built or designed helped them worship or understand more."]},
 {id:"discernment",name:"Discernment",ref:"1 Corinthians 12:10",def:"The Spirit-given ability to distinguish truth from error and the genuine from the counterfeit, in teaching, in motives, and in spiritual influences.",q:[
  "I often sense when a teaching or a person isn't right, even before I can explain why.",
  "I notice when someone's words and motives don't match.",
  "I can tell when something sounds good but doesn't line up with Scripture.",
  "People come to me to help them tell whether something is truly from God."]},
 {id:"evangelism",name:"Evangelism",ref:"Ephesians 4:11",def:"The Spirit-given ability to share the gospel with unbelievers in a way that moves them toward faith in Jesus.",q:[
  "I look for chances to bring up Jesus with people who don't know him.",
  "I feel joy, not dread, when I explain the gospel to someone who doesn't believe.",
  "I'm burdened for people far from God and want to do something about it.",
  "I've seen people begin to trust Christ after talking with me."]},
 {id:"exhortation",name:"Exhortation",ref:"Romans 12:8",def:"The Spirit-given ability to come alongside people and move them forward: comforting the discouraged, challenging the stuck, and calling out what God is doing in someone before they can see it themselves.",q:[
  "I enjoy encouraging people who are discouraged or stuck.",
  "I can often see what God is doing in someone and I love telling them.",
  "I'm willing to say a hard thing, kindly, to help someone take their next step.",
  "People often seek me out for a word of encouragement or direction."]},
 {id:"faith",name:"Faith",ref:"1 Corinthians 12:9",def:"The Spirit-given ability to trust God for what looks impossible, and to steady everyone else while He does it.",q:[
  "I stay calm and trust God when a situation looks impossible.",
  "I'm often sure God will provide when others see no way forward.",
  "I'm willing to step out on a big, God-sized goal before the resources are in sight.",
  "Others have told me my trust in God steadied them in a hard time."]},
 {id:"giving",name:"Giving",ref:"Romans 12:8",def:"The Spirit-given ability to contribute money and resources to God's work with unusual generosity, wisdom, and joy.",q:[
  "I enjoy giving money or resources well beyond what's expected.",
  "I look for needs I can meet with what I have, often without anyone knowing.",
  "I think of my income as something to use for God's work.",
  "People have commented on how generous I am."]},
 {id:"healing",name:"Healing",ref:"1 Corinthians 12:9",def:"The Spirit-given ability to be God's instrument of restoration in another person's body, mind, or spirit, most often through prayer.",q:[
  "I feel drawn to pray for people who are sick or hurting in body or mind.",
  "When I pray for someone who is ill, I often sense God's presence or leading.",
  "I believe God still heals today and I'm willing to ask boldly.",
  "People have told me they were helped or restored after I prayed with them."]},
 {id:"helps",name:"Helps",ref:"1 Corinthians 12:28",def:"The Spirit-given ability to free other people for their ministry by taking real work off their plate.",q:[
  "I'm glad to take tasks off someone's plate so they can focus on their ministry.",
  "I'd rather support someone's work behind the scenes than lead it.",
  "I notice what a person needs in order to do their job well and quietly handle it.",
  "Leaders have told me I make their work easier."]},
 {id:"hospitality",name:"Hospitality",ref:"1 Peter 4:9",def:"The Spirit-given ability to make people feel genuinely welcomed, safe, and at home, strangers included, especially.",q:[
  "I love making guests feel at home, especially newcomers and strangers.",
  "I enjoy opening my home or my time to people.",
  "I notice who is standing alone and go introduce myself.",
  "People have told me they felt welcomed because of me."]},
 {id:"intercession",name:"Intercession",ref:"Colossians 4:12-13",def:"The Spirit-given ability to pray for others persistently, specifically, and with unusual burden and effect.",q:[
  "I'm drawn to pray for others for long stretches of time.",
  "I keep praying about a specific need until I sense God has answered.",
  "I'm often moved to pray for someone before I even know what's going on.",
  "People ask me to pray for them because they've seen God answer."]},
 {id:"knowledge",name:"Knowledge",ref:"1 Corinthians 12:8",def:"The Spirit-given ability to learn, retain, and organize the truths of God's Word, and to bring the right truth to bear at the right moment.",q:[
  "I love studying Scripture and I remember what I learn.",
  "I can connect passages and facts and organize them so they make sense together.",
  "The right verse or biblical truth often comes to mind at just the right moment.",
  "People come to me to find out what the Bible says about something."]},
 {id:"leadership",name:"Leadership",ref:"Romans 12:8",def:"The Spirit-given ability to set direction for God's people and move them toward it together, with zeal, Scripture says.",q:[
  "When a group has no direction, I naturally step up and set one.",
  "I can get people excited about a shared goal and moving together.",
  "I'm comfortable carrying responsibility and making decisions for a group.",
  "People follow me even when I haven't been given official authority."]},
 {id:"mercy",name:"Mercy",ref:"Romans 12:8",def:"The Spirit-given ability to feel the pain of hurting people and move toward them with practical, cheerful compassion.",q:[
  "I feel other people's pain deeply and want to move toward it.",
  "I enjoy caring for people who are hurting, lonely, or overlooked.",
  "I can sit with someone in their grief without needing to fix it.",
  "People tell me they feel comforted and safe around me."]},
 {id:"miracles",name:"Miracles",ref:"1 Corinthians 12:10",def:"The Spirit-given ability to be God's instrument for works of power that go beyond natural explanation, interventions that authenticate the gospel and awaken faith.",q:[
  "I've seen God do things through prayer that can't be explained naturally.",
  "I pray expecting God to do the extraordinary.",
  "When something supernatural happens, I'm drawn toward it rather than afraid of it.",
  "Others have said God worked in powerful, unexplainable ways through me."]},
 {id:"missionary",name:"Missionary",ref:"Acts 13:2-3",def:"The Spirit-given ability to minister effectively across cultures: to leave what's familiar, love what's foreign, and make the gospel at home in a culture not your own.",q:[
  "I feel drawn to people of other cultures and nationalities.",
  "I'd be willing to move somewhere unfamiliar to share the gospel.",
  "I adapt quickly to new customs, languages, and ways of life.",
  "Others have told me they could see me thriving in cross-cultural ministry."]},
 {id:"music",name:"Music",ref:"1 Chronicles 25:1-7",def:"The Spirit-given ability to lead God's people toward Him through song and skillful playing, using melody to teach, unite, and lift the church's heart.",q:[
  "I feel most alive when I'm singing or playing to help others worship.",
  "I pick up music quickly and can help a group sing together.",
  "I'm drawn to songs that help people say true things about God.",
  "People have told me the music I sing or play helped them draw closer to God."]},
 {id:"prophecy",name:"Prophecy",ref:"1 Corinthians 14:3",def:"The Spirit-given ability to declare God's truth with timeliness and power, speaking to people, as Paul defines it, \u201Cfor their upbuilding and encouragement and consolation.\u201D",q:[
  "I feel a strong pull to speak God's truth even when it's uncomfortable.",
  "I often sense what God wants to say to a person or group at a particular moment.",
  "When I speak a message from God, my aim is to build up, encourage, and comfort.",
  "People tell me something I shared was exactly what they needed to hear."]},
 {id:"service",name:"Service",ref:"Romans 12:7",def:"The Spirit-given ability to see practical needs and joyfully meet them: the ministry of stacked chairs, filled coffee urns, and jobs done before anyone asked.",q:[
  "I notice practical needs like setup, cleanup, and supplies and jump in without being asked.",
  "I find real joy in tasks other people overlook.",
  "I'd rather roll up my sleeves than sit through a discussion about the problem.",
  "People say I'm dependable and always show up to help."]},
 {id:"shepherding",name:"Shepherding",ref:"Ephesians 4:11",def:"The Spirit-given ability to care for a group of believers over time: feeding, protecting, guiding, and going after the one who wanders.",q:[
  "I enjoy caring for the same group of people over a long period.",
  "When someone drifts away, I feel I should go after them.",
  "I feel responsible to guide, protect, and spiritually feed the people around me.",
  "People think of me as their pastor or shepherd, even without the title."]},
 {id:"teaching",name:"Teaching",ref:"Romans 12:7",def:"The Spirit-given ability to explain God's Word so clearly that people understand it, believe it, and live it.",q:[
  "I love explaining Scripture so that other people truly get it.",
  "I spend time organizing what I learn so I can teach it clearly.",
  "I light up when someone finally understands something I've been explaining.",
  "People say I make difficult ideas easy to follow."]},
 {id:"tongues",name:"Tongues & Interpretation",ref:"1 Corinthians 12:10",def:"The Spirit-given ability to pray or speak in a language the speaker hasn't learned; the gift of interpretation makes that speech intelligible so the church is built up.",q:[
  "I have prayed or spoken in a language I have not learned.",
  "I sometimes sense the meaning of a message that was spoken in tongues.",
  "I'm comfortable in settings where tongues are used in an orderly way to build up the church.",
  "Others have confirmed that a message I gave in tongues, or interpreted, was from God."]},
 {id:"wisdom",name:"Wisdom",ref:"1 Corinthians 12:8",def:"The Spirit-given ability to apply God's truth to real situations: knowing not just what's true, but what to do.",q:[
  "People ask me what to do when a situation is complicated.",
  "I often see a practical, godly way through a problem.",
  "I know not only what is true but what to do about it.",
  "Others have said my advice turned out to be wise."]}
];

